mullvad:
    # `wg genkey` output, 44 characters of base64. Never leaves the machine.
    private_key: REPLACE_ME_44_CHAR_BASE64_WIREGUARD_PRIVATE_KEY

    # Addresses Mullvad assigned to this key, comma-separated. Public-ish, but
    # they tie this repository to a Mullvad device, so they stay encrypted
    # alongside the key rather than in git.
    address: 10.0.0.0/32,fc00:bbbb:bbbb:bb01::0:0000/128

    # Relay endpoint, host:port. From the public relay API.
    endpoint: 0.0.0.0:51820

    # Relay WireGuard public key. Also from the public relay API.
    peer_public_key: REPLACE_ME_44_CHAR_BASE64_RELAY_PUBLIC_KEY
