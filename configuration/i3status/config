general {
    output_format = "i3bar"
    colors = false
    interval = 5
}

order += "wireless wlp9s0"
order += "volume master"
order += "tztime local"

wireless wlp9s0 {
    format_up = "W: %essid %quality"
    format_down = "W: down"
}

volume master {
    format = "V: %volume"
    format_muted = "V: muted (%volume)"
    device = "pulse"
}

tztime local {
    format = "%Y-%m-%d %H:%M"
}
