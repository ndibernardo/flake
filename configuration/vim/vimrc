" foot's Control+Shift+c copies only its own selection and never reaches Vim,
" so a mouse selection is copied when the drag ends and a keyboard selection
" when visual mode ends without changing or yanking anything.
let s:yanks = 0
let s:visual = {}

function! s:copy_finished_visual() abort
  if mode() =~# "^[vV\<C-v>]"
    let s:visual = { 'buffer': bufnr(), 'tick': b:changedtick, 'yanks': s:yanks }
    return
  endif
  let l:visual = s:visual
  let s:visual = {}
  if mode() ==# 'n' && l:visual ==# { 'buffer': bufnr(), 'tick': b:changedtick, 'yanks': s:yanks }
    let l:view = winsaveview()
    normal! gv"+y
    call winrestview(l:view)
  endif
endfunction

augroup clipboard
  autocmd!
  autocmd TextYankPost * let s:yanks += 1
  autocmd SafeState * ++nested call s:copy_finished_visual()
augroup END

