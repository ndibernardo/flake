function! s:command(command) abort
  return {_ -> executable(a:command[0]) ? a:command : []}
endfunction

function! s:root(markers) abort
  return {_ -> lsp#utils#path_to_uri(s:nearest(a:markers + ['.git/']))}
endfunction

function! s:nearest(markers) abort
  let l:directory = lsp#utils#find_nearest_parent_file_directory(lsp#utils#get_buffer_path(), a:markers)
  return empty(l:directory) ? getcwd() : l:directory
endfunction

function! s:register_servers() abort
  call lsp#register_server({
        \ 'name': 'elixir-ls',
        \ 'cmd': s:command(['elixir-ls']),
        \ 'root_uri': s:root(['mix.exs']),
        \ 'allowlist': ['elixir', 'eelixir'],
        \ })
  call lsp#register_server({
        \ 'name': 'gopls',
        \ 'cmd': s:command(['gopls']),
        \ 'root_uri': s:root(['go.work', 'go.mod']),
        \ 'allowlist': ['go', 'gomod'],
        \ })
  call lsp#register_server({
        \ 'name': 'metals',
        \ 'cmd': s:command(['metals']),
        \ 'root_uri': s:root(['build.sbt', 'build.sc', 'build.mill']),
        \ 'initialization_options': {
        \   'statusBarProvider': 'show-message',
        \   'isHttpEnabled': v:true,
        \   'compilerOptions': { 'snippetAutoIndent': v:false },
        \ },
        \ 'allowlist': ['scala', 'sbt'],
        \ })
  call lsp#register_server({
        \ 'name': 'nixd',
        \ 'cmd': s:command(['nixd']),
        \ 'root_uri': s:root(['flake.nix']),
        \ 'workspace_config': { 'nixd': { 'formatting': { 'command': ['nixfmt'] } } },
        \ 'allowlist': ['nix'],
        \ })
  call lsp#register_server({
        \ 'name': 'rust-analyzer',
        \ 'cmd': s:command(['rust-analyzer']),
        \ 'root_uri': s:root(['Cargo.toml']),
        \ 'initialization_options': { 'cargo': { 'features': 'all' } },
        \ 'allowlist': ['rust'],
        \ })
  call lsp#register_server({
        \ 'name': 'typescript-language-server',
        \ 'cmd': s:command(['typescript-language-server', '--stdio']),
        \ 'root_uri': s:root(['tsconfig.json', 'jsconfig.json', 'package.json']),
        \ 'allowlist': ['javascript', 'javascriptreact', 'typescript', 'typescriptreact'],
        \ })
endfunction

function! s:on_lsp_buffer_enabled() abort
  setlocal omnifunc=lsp#complete
  nmap <buffer> gd <Plug>(lsp-definition)
  nmap <buffer> gr <Plug>(lsp-references)
  nmap <buffer> grr <Plug>(lsp-references)
  nmap <buffer> gI <Plug>(lsp-implementation)
  nmap <buffer> gD <Plug>(lsp-declaration)
  nmap <buffer> K <Plug>(lsp-hover)
  nmap <buffer> <leader>D <Plug>(lsp-type-definition)
  nmap <buffer> <leader>ds <Plug>(lsp-document-symbol-search)
  nmap <buffer> <leader>ws <Plug>(lsp-workspace-symbol-search)
  nmap <buffer> <leader>rr <Plug>(lsp-rename)
  nmap <buffer> <leader>ca <Plug>(lsp-code-action)
  nmap <buffer> <leader>f <Plug>(lsp-document-format)
  nmap <buffer> ]d <Plug>(lsp-next-diagnostic)
  nmap <buffer> [d <Plug>(lsp-previous-diagnostic)
endfunction

augroup lsp-setup
  autocmd!
  autocmd User lsp_setup call s:register_servers()
  autocmd User lsp_buffer_enabled call s:on_lsp_buffer_enabled()
augroup END

