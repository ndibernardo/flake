function! s:format() abort
  if !exists('g:neoformat_enabled_' . &filetype)
    return
  endif
  try
    undojoin
    Neoformat
  catch /E790/
    Neoformat
  endtry
endfunction

augroup format-on-save
  autocmd!
  autocmd BufWritePre * call s:format()
augroup END

