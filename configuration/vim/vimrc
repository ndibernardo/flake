" This Vim has no Wayland clipboard of its own, so wl-clipboard backs the + and
" * registers.
function! s:wl_copy(register, type, lines) abort
  call system('wl-copy' . (a:register ==# '*' ? ' --primary' : ''), a:type ==# 'V' ? a:lines + [''] : a:lines)
endfunction

function! s:wl_paste(register) abort
  let l:text = system('wl-paste --no-newline' . (a:register ==# '*' ? ' --primary' : ''))
  if v:shell_error
    return []
  endif
  let l:lines = split(l:text, "\n", 1)
  return l:text =~# "\n$" ? ['V', l:lines[:-2]] : ['v', l:lines]
endfunction

