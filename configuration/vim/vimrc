function! s:command(command) abort
  return {_ -> executable(a:command[0]) ? a:command : []}
endfunction

function! s:root(markers) abort
  return {_ -> lsp#utils#path_to_uri(s:nearest(a:markers + ['.git/']))}
endfunction

function! s:nearest(markers) abort
  let l:directory = lsp#utils#find_nearest_parent_file_directory(lsp#utils#get_buffer_path(), a:markers)
  return empty(l:directory) ? getcwd() : l:directory
endfunction

function! s:register_servers() abort
  call lsp#register_server({
        \ 'name': 'elixir-ls',
        \ 'cmd': s:command(['elixir-ls']),
        \ 'root_uri': s:root(['mix.exs']),
        \ 'allowlist': ['elixir', 'eelixir'],
        \ })
  call lsp#register_server({
        \ 'name': 'gopls',
        \ 'cmd': s:command(['gopls']),
        \ 'root_uri': s:root(['go.work', 'go.mod']),
        \ 'allowlist': ['go', 'gomod'],
        \ })
  call lsp#register_server({
        \ 'name': 'metals',
        \ 'cmd': s:command(['metals']),
        \ 'root_uri': s:root(['build.sbt', 'build.sc', 'build.mill']),
        \ 'initialization_options': {
        \   'statusBarProvider': 'show-message',
        \   'isHttpEnabled': v:true,
        \   'compilerOptions': { 'snippetAutoIndent': v:false },
        \ },
        \ 'allowlist': ['scala', 'sbt'],
        \ })
  call lsp#register_server({
        \ 'name': 'nixd',
        \ 'cmd': s:command(['nixd']),
        \ 'root_uri': s:root(['flake.nix']),
        \ 'workspace_config': { 'nixd': { 'formatting': { 'command': ['nixfmt'] } } },
        \ 'allowlist': ['nix'],
        \ })
  call lsp#register_server({
        \ 'name': 'racket-langserver',
        \ 'cmd': {_ -> s:raco_pkg('racket-langserver') ? ['racket', '-l', 'racket-langserver'] : []},
        \ 'root_uri': s:root(['info.rkt']),
        \ 'allowlist': ['racket'],
        \ })
  call lsp#register_server({
        \ 'name': 'rust-analyzer',
        \ 'cmd': s:command(['rust-analyzer']),
        \ 'root_uri': s:root(['Cargo.toml']),
        \ 'initialization_options': { 'cargo': { 'features': 'all' } },
        \ 'allowlist': ['rust'],
        \ })
  call lsp#register_server({
        \ 'name': 'typescript-language-server',
        \ 'cmd': s:command(['typescript-language-server', '--stdio']),
        \ 'root_uri': s:root(['tsconfig.json', 'jsconfig.json', 'package.json']),
        \ 'allowlist': ['javascript', 'javascriptreact', 'typescript', 'typescriptreact'],
        \ })
endfunction

