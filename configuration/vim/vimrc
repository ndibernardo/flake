" <LocalLeader> only has mappings in these buffers, so only they get the popup.
function! s:local_which_key() abort
  let b:which_key_local_map = deepcopy(s:which_key_sexp_map)
  if &filetype ==# 'racket'
    call extend(b:which_key_local_map.e, s:which_key_racket_map.e)
    let b:which_key_local_map.r = deepcopy(s:which_key_racket_map.r)
  endif
  nnoremap <buffer> <silent> <LocalLeader> :<C-u>WhichKey maplocalleader<CR>
endfunction

augroup which-key
  autocmd!
  autocmd VimEnter * call which_key#register('<Space>', 'g:which_key_map')
  " A string is evaluated on each popup, so every buffer shows its own map.
  autocmd VimEnter * call which_key#register(maplocalleader, 'b:which_key_local_map')
  execute 'autocmd FileType' g:sexp_filetypes 'call s:local_which_key()'
augroup END
